# Release image: GoReleaser has already built the binary, with the UI embedded, for each platform.
# The runtime matches the final stage of Dockerfile, which CI and dev images still use.
FROM alpine:3.24.2
RUN apk add --no-cache ca-certificates
ARG TARGETPLATFORM
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/koihq/koi"
COPY $TARGETPLATFORM/koi /usr/local/bin/koi
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
    CMD ["koi", "healthcheck"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["koi"]
