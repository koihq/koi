# Copy to .env.selfhosted. Use a published Koi image tag, for example v0.1.0.
KOI_IMAGE_TAG=
# Use openssl rand -hex 24: URL-safe in KOI_DATABASE_URL.
POSTGRES_PASSWORD=
# Required only for live visibility collection with your own Cloro account.
KOI_CLORO_API_KEY=
# Optional integrations.
KOI_OPENROUTER_API_KEY=
KOI_RESEND_API_KEY=
KOI_EMAIL_FROM=
KOI_PUBLIC_URL=
LOGODEV_SECRET_KEY=
# Only the first user can sign up, so nobody else can spend your Cloro credits. Set to true for
# as long as you want to let others in.
KOI_ALLOW_SIGNUP=
# Header your reverse proxy overwrites with the client's address, such as X-Real-IP. Without it, all
# visitors share one rate limit. Do not set it unless the proxy overwrites the header.
KOI_CLIENT_IP_HEADER=
# Local reverse-proxy port; bind stays on 127.0.0.1.
KOI_HOST_PORT=8080

