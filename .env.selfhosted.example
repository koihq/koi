# install.sh fills this file. For a manual install, copy it to .env.selfhosted and set a
# published image tag, for example v0.2.0. See docs/configuration.md for every variable.
KOI_IMAGE_TAG=
# Use openssl rand -hex 24: URL-safe in KOI_DATABASE_URL.
POSTGRES_PASSWORD=
# Required only for live visibility collection with your own Cloro account.
KOI_CLORO_API_KEY=
# Optional integrations.
KOI_OPENROUTER_API_KEY=
KOI_RESEND_API_KEY=
KOI_EMAIL_FROM=
# HTTPS address of this instance. Marks the session cookie Secure and enables email links.
KOI_PUBLIC_URL=
# Only when the MCP endpoint uses a different hostname than KOI_PUBLIC_URL.
KOI_MCP_PUBLIC_URL=
# Logo.dev company search (secret, server only) and logos (publishable pk_ key).
LOGODEV_SECRET_KEY=
VITE_LOGODEV_PUBLISHABLE_KEY=
# Only the first user can sign up, so nobody else can spend your Cloro credits. Set to true for
# as long as you want to let others in.
KOI_ALLOW_SIGNUP=
# Header your reverse proxy overwrites with the client's address, such as X-Real-IP. Without it, all
# visitors share one rate limit. Do not set it unless the proxy overwrites the header.
KOI_CLIENT_IP_HEADER=
# Local reverse-proxy port; bind stays on 127.0.0.1.
KOI_HOST_PORT=8080

