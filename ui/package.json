{
  "name": "ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts && vite build --config vite.site.config.ts --ssr entry-server.tsx --outDir dist-ssr && node site/prerender.mjs",
    "site:preview": "vite preview --config vite.site.config.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write .",
    "check:fix-unsafe": "biome check --write --unsafe .",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "prepare": "cd .. && husky ui/.husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "i18next": "26.4.2",
    "lucide-react": "0.468.0",
    "nuqs": "2.10.1",
    "posthog-js": "1.447.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "17.0.12",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-cli": "1.167.35",
    "@tanstack/router-plugin": "1.168.37",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "5.0.0",
    "husky": "^9.1.7",
    "msw": "3.0.3",
    "shadcn": "4.23.0",
    "typescript": "^6.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.0",
    "vitest-browser-react": "2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
