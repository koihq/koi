KOI_PORT=:8080
KOI_DATABASE_URL=postgres://koi:koi@localhost:5432/koi?sslmode=disable
# Required for live visibility collection, including self-hosted instances
KOI_CLORO_API_KEY=
# openssl rand -base64 32
KOI_SESSION_SECRET=
KOI_LOG_LEVEL=info
KOI_LOG_FORMAT=text
# Optional: onboarding research and prompt/competitor drafting
KOI_OPENROUTER_API_KEY=
KOI_WORKER_CONCURRENCY=4
# Timeout per provider call; generation job budget is twice this plus 30s
KOI_PROVIDER_TIMEOUT=3m
KOI_DB_MAX_OPEN_CONNS=12
# Optional: company search and logos
LOGODEV_SECRET_KEY=
VITE_LOGODEV_PUBLISHABLE_KEY=
