KOI_PORT=:8080
KOI_DATABASE_URL=postgres://koi:koi@localhost:5432/koi?sslmode=disable
# Required in cloud mode; optional in self-hosted mode (enables live collection)
KOI_CLORO_API_KEY=
# Absolute session lifetime from login; defaults to 8h
KOI_SESSION_LIFETIME=8h
KOI_LOG_LEVEL=info
KOI_LOG_FORMAT=text
# Optional: onboarding research and prompt/competitor drafting
KOI_OPENROUTER_API_KEY=
# Welcome and password reset emails, required in cloud mode; configure both after verifying a
# sending domain in Resend. Password reset also needs KOI_PUBLIC_URL for its link.
KOI_RESEND_API_KEY=
KOI_EMAIL_FROM=
KOI_WORKER_CONCURRENCY=4
# Timeout per provider call; generation job budget is twice this plus 30s
KOI_PROVIDER_TIMEOUT=3m
KOI_DB_MAX_OPEN_CONNS=12
KOI_DEPLOYMENT_MODE=selfhosted
# Browser origin. In Vite development set http://localhost:5173; required in cloud mode.
KOI_PUBLIC_URL=
# Public origin of the MCP endpoint; set to http://localhost:8080 with Vite dev.
# Defaults to KOI_PUBLIC_URL when the API and browser share one origin.
KOI_MCP_PUBLIC_URL=
KOI_STRIPE_SECRET_KEY=
KOI_STRIPE_WEBHOOK_SECRET=
KOI_STRIPE_PRICE_ID=
# Koi Cloud: free one-time checks allowed across all organizations in 24 hours.
KOI_FIRST_LOOK_DAILY_LIMIT=100
# Defaults to true in cloud mode and false in self-hosted mode, which admits only the first user.
KOI_ALLOW_SIGNUP=
# Header a trusted proxy overwrites with the client's address: CF-Connecting-IP behind Cloudflare,
# X-Real-IP behind Nginx. Without it, everyone behind the proxy shares one rate limit.
KOI_CLIENT_IP_HEADER=
# Optional: company search and logos
LOGODEV_SECRET_KEY=
VITE_LOGODEV_PUBLISHABLE_KEY=
# Optional product analytics. Set only on Koi Cloud production: without a key nothing is sent and
# the app loads no analytics code. The host defaults to PostHog EU.
KOI_POSTHOG_KEY=
KOI_POSTHOG_HOST=
# Comma-separated accounts that never send analytics, such as the team's own.
KOI_ANALYTICS_EXCLUDED_EMAILS=
