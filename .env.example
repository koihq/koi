KOI_PORT=:8080
KOI_DATABASE_URL=postgres://koi:koi@localhost:5432/koi?sslmode=disable
# Required in cloud mode; optional in self-hosted mode (enables live collection)
KOI_CLORO_API_KEY=
# Required by current configuration; openssl rand -base64 32
KOI_SESSION_SECRET=
# Absolute session lifetime from login; defaults to 8h
KOI_SESSION_LIFETIME=8h
KOI_LOG_LEVEL=info
KOI_LOG_FORMAT=text
# Optional: onboarding research and prompt/competitor drafting
KOI_OPENROUTER_API_KEY=
# Optional welcome email; configure both after verifying a sending domain in Resend
KOI_RESEND_API_KEY=
KOI_EMAIL_FROM=
KOI_WORKER_CONCURRENCY=4
# Timeout per provider call; generation job budget is twice this plus 30s
KOI_PROVIDER_TIMEOUT=3m
KOI_DB_MAX_OPEN_CONNS=12
KOI_DEPLOYMENT_MODE=selfhosted
# Browser origin. In Vite development set http://localhost:5173; required in cloud mode.
KOI_PUBLIC_URL=
# Public origin of the MCP endpoint; set to http://localhost:8080 with Vite dev.
# Defaults to KOI_PUBLIC_URL when the API and browser share one origin.
KOI_MCP_PUBLIC_URL=
KOI_STRIPE_SECRET_KEY=
KOI_STRIPE_WEBHOOK_SECRET=
KOI_STRIPE_PRICE_ID=
# Optional: company search and logos
LOGODEV_SECRET_KEY=
VITE_LOGODEV_PUBLISHABLE_KEY=
